    "verify:demo-auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --env-file=.env.local --env-file=.env.seed.local scripts/verify-demo-auth.mjs",
    "verify:phase4": "node --env-file=.env.local --env-file=.env.seed.local scripts/verify-phase4.mjs",
