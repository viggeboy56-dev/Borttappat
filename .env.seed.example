# Endast för lokal utveckling mot ett separat dev-projekt.
# Filen ska kopieras till .env.seed.local, som ignoreras av Git.
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-dev-secret-key

# Välj unika, starka lösenord lokalt. Checka aldrig in dem.
DEMO_ADMIN_PASSWORD=replace-with-a-strong-local-password
DEMO_STAFF_PASSWORD=replace-with-a-strong-local-password
DEMO_MEMBER_PASSWORD=replace-with-a-strong-local-password
