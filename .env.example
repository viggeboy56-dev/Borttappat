# Krävs för inloggning, sessionscookies och databasåtkomst.
# Kopiera filen till .env.local och fyll i värden från Supabase Connect.
# Publishable key får användas i webbläsaren. Lägg aldrig service_role här.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
